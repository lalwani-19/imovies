# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imovies?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/imovies
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Allowed Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
